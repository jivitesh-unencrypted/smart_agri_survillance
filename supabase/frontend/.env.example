# =====================================================================
# FRONTEND ENVIRONMENT  (frontend/.env)
# ---------------------------------------------------------------------
# Copy this file to `.env`:
#     frontend> copy .env.example .env
#
# These values are BAKED INTO THE PUBLIC BUNDLE that Cloudflare Pages
# serves. Only ever put the Supabase *anon / publishable* key here.
# The service-role key must NEVER appear in this file.
# =====================================================================

# Supabase Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...  # anon/publishable key ONLY

# Local AI server (runs on the machine with the cameras + YOLO).
# In production the frontend is on https://<project>.pages.dev while the
# AI server is still http://<LAN-IP>:8000 on-site.
VITE_AI_SERVER_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
