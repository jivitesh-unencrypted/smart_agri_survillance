ai-server/models/*
!ai-server/models/.gitkeep

# ---- Old SQLite backend (pre-migration, kept only as a migration source) ----
*.db
*.sqlite3

# ---- Frontend ----
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ---- Editors / OS ----
.vscode/
.idea/
.DS_Store
