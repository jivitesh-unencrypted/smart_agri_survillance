# =====================================================================
# LOCAL AI SERVER ENVIRONMENT  (ai-server/.env)
# ---------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values:
#     ai-server> copy .env.example .env
#
# !! `.env` is git-ignored. NEVER commit it and NEVER paste these
# !! values into frontend code - everything here is server-side only.
# =====================================================================

# --- Supabase (Project Settings -> API) -----------------------------
# The anon/publishable key is for the FRONTEND. The service-role key
# below is for THIS process only. The service-role key bypasses all
# Row Level Security - treat it exactly like a database password.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...  # server-only, never send to a browser

# Storage bucket that holds detection snapshots (see supabase/migrations/0004_storage_setup.sql)
SUPABASE_STORAGE_BUCKET=snapshots

# --- Cloud sync / offline behaviour ---------------------------------
# SYNC_ENABLED=false  -> fully offline mode: detection still runs, events
#                        are queued in data/outbox.db and pushed later.
SYNC_ENABLED=true
# UPLOAD_SNAPSHOTS=false -> snapshots stay 100% on this machine (only
#                        small event metadata goes to the cloud).
UPLOAD_SNAPSHOTS=true
SYNC_INTERVAL_SECONDS=15
OUTBOX_MAX_ATTEMPTS=8

# --- AI model -------------------------------------------------------
# Keep your trained weights here; they are never replaced.
MODEL_PATH=./models/yolov8n.pt
DEFAULT_CONFIDENCE_THRESHOLD=0.25
DEFAULT_IOU_THRESHOLD=0.45

# --- CORS: frontend origin(s) allowed to call this local server -----
# Add your Cloudflare Pages URL when you deploy the frontend, e.g.
#   CORS_ORIGINS=http://localhost:5173,https://your-project.pages.dev
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Server ---------------------------------------------------------
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
